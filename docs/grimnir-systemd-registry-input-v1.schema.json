{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/brokkr-systemd-registry-input/v1/schema.json",
  "title": "Brokkr systemd registry input adapter v1",
  "description": "Bounded validation for the fields Brokkr consumes from the authoritative Grimnir registry. This schema is not a topology authority and permits unrelated registry fields.",
  "type": "object",
  "additionalProperties": true,
  "required": ["components"],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]{2,62}$"
    },
    "unit-name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[\\r\\n])[A-Za-z0-9:_.@-]+$"
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/unit-name" },
        "type": { "enum": ["service", "timer"] },
        "scope": { "enum": ["system", "user"] }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "target_node_id": { "$ref": "#/$defs/id" },
        "systemd_units": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/unit" }
        }
      }
    }
  }
}
