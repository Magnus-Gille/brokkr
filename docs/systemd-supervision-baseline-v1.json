{
  "kind": "systemd-supervision-baseline",
  "schema_version": "v1",
  "baseline_id": "fleet-systemd-supervision",
  "authority": {
    "topology": "grimnir-service-registry",
    "failure_delivery": "brokkr-systemd-failure-v1",
    "audit": "brokkr-systemd-supervision-audit-v1"
  },
  "freshness": {
    "max_age_seconds": 900,
    "future_skew_seconds": 0
  },
  "scopes": {
    "system": {
      "manager": "system",
      "failure_delivery": {
        "required": true,
        "mode": "brokkr-systemd-failure"
      }
    },
    "user": {
      "manager": "user",
      "failure_delivery": {
        "required": true,
        "mode": "component-owner"
      }
    }
  },
  "workloads": {
    "long-running": {
      "unit_type": "service",
      "restart": {
        "required": true,
        "allowed": ["on-failure", "on-abnormal"],
        "delay": { "required": true, "min_seconds": 1, "max_seconds": 60 }
      },
      "start_limits": {
        "interval": { "required": true, "min_seconds": 60, "max_seconds": 3600 },
        "burst": { "required": true, "min": 2, "max": 10 }
      },
      "timeouts": {
        "start": { "required": true, "min_seconds": 1, "max_seconds": 120 },
        "stop": { "required": true, "min_seconds": 1, "max_seconds": 120 },
        "runtime": { "required": true, "allow_infinity": true, "min_seconds": 60, "max_seconds": 86400 }
      },
      "oom": { "required": true, "allowed": ["stop", "kill"] },
      "failure_delivery": { "required": true, "mode": "brokkr-systemd-failure" },
      "readiness": { "required": true }
    },
    "oneshot": {
      "unit_type": "service",
      "restart": {
        "required": true,
        "allowed": ["no"],
        "delay": { "required": false, "min_seconds": 0, "max_seconds": 0 }
      },
      "start_limits": {
        "interval": { "required": true, "min_seconds": 60, "max_seconds": 3600 },
        "burst": { "required": true, "min": 1, "max": 10 }
      },
      "timeouts": {
        "start": { "required": true, "min_seconds": 1, "max_seconds": 3600 },
        "stop": { "required": true, "min_seconds": 1, "max_seconds": 300 },
        "runtime": { "required": true, "allow_infinity": true, "min_seconds": 60, "max_seconds": 86400 }
      },
      "oom": { "required": true, "allowed": ["stop", "kill"] },
      "failure_delivery": { "required": true, "mode": "brokkr-systemd-failure" },
      "readiness": { "required": false }
    },
    "timer": {
      "unit_type": "timer",
      "persistence": { "required": true, "allowed": [true] },
      "accuracy": { "required": true, "min_seconds": 1, "max_seconds": 3600 },
      "schedule": {
        "required": true,
        "directives": ["OnCalendar", "OnBootSec", "OnStartupSec", "OnUnitActiveSec", "OnUnitInactiveSec"]
      },
      "missed_runs": true
    }
  },
  "watchdog": {
    "directive": "WatchdogSec",
    "requires_type": "notify",
    "min_seconds": 5,
    "max_seconds": 300,
    "requires_app_heartbeat": true,
    "requires_live_lock_fixture": true
  },
  "observations": {
    "content_blind": true,
    "fields": [
      "unit_result",
      "restart_count_window",
      "watchdog_result",
      "oom_result",
      "timer_last_next_run",
      "audit_freshness"
    ]
  },
  "extensions": []
}
