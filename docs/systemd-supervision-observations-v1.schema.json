{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/systemd-supervision-observations/v1/schema.json",
  "title": "Brokkr systemd supervision observations v1",
  "description": "Bounded, content-blind systemd state evidence. target_node_id is a Grimnir-owned public-safe opaque identifier used with scope and effective name as the stable join key; projections must not carry unit content, command lines, environment, journal text, credentials, or private locators.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "observed_at", "notifiers", "units"],
  "properties": {
    "kind": { "const": "systemd-supervision-observations" },
    "schema_version": { "const": "v1" },
    "observed_at": { "$ref": "#/$defs/utc" },
    "notifiers": { "oneOf": [{ "type": "null" }, { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/notifier" } }] },
    "units": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/unit" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 3, "maxLength": 63, "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "unit-name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*[\\r\\n])[A-Za-z0-9:_.@-]+\\.(?:service|timer)$" },
    "utc": { "type": "string", "minLength": 20, "maxLength": 20, "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$", "format": "date-time" },
    "notifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_node_id", "status"],
      "properties": {
        "target_node_id": { "$ref": "#/$defs/id" },
        "status": { "oneOf": [{ "type": "null" }, { "enum": ["available", "absent", "unknown"] }] }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_state", "sub_state", "result"],
      "properties": {
        "active_state": { "enum": ["active", "inactive", "failed", "activating", "deactivating", "unknown"] },
        "sub_state": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "result": { "enum": ["success", "exit-code", "signal", "core-dump", "watchdog", "oom-kill", "timeout", "start-limit-hit", "resources", "protocol", "condition", "unknown"] }
      }
    },
    "restart-window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "window_start", "window_end"],
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "window_start": { "$ref": "#/$defs/utc" },
        "window_end": { "$ref": "#/$defs/utc" }
      }
    },
    "watchdog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": { "result": { "enum": ["not-requested", "ok", "timeout", "unknown"] } }
    },
    "oom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": { "result": { "enum": ["not-applicable", "none", "killed", "unknown"] } }
    },
    "timer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_run_at", "next_run_at", "last_result", "missed_runs", "persistent"],
      "properties": {
        "last_run_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/utc" }] },
        "next_run_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/utc" }] },
        "last_result": { "enum": ["success", "failed", "not-run", "unknown"] },
        "missed_runs": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 100000 }] },
        "persistent": { "oneOf": [{ "type": "null" }, { "type": "boolean" }] }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_node_id", "scope", "name", "result", "restart", "watchdog", "oom", "timer"],
      "properties": {
        "target_node_id": { "$ref": "#/$defs/id" },
        "scope": { "enum": ["system", "user"] },
        "name": { "$ref": "#/$defs/unit-name" },
        "result": { "$ref": "#/$defs/result" },
        "restart": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/restart-window" }] },
        "watchdog": { "$ref": "#/$defs/watchdog" },
        "oom": { "$ref": "#/$defs/oom" },
        "timer": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timer" }] }
      }
    }
  }
}
