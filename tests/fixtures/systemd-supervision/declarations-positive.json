{
  "kind": "systemd-unit-declarations",
  "schema_version": "v1",
  "topology_authority": "grimnir-service-registry",
  "units": [
    {
      "target_node_id": "node-core",
      "scope": "system",
      "name": "grimnir-api.service",
      "failure_handler_role": "none",
      "directives": {
        "Type": "notify",
        "Restart": "on-failure",
        "RestartSec": "5s",
        "StartLimitIntervalSec": "60s",
        "StartLimitBurst": "5",
        "TimeoutStartSec": "30s",
        "TimeoutStopSec": "30s",
        "RuntimeMaxSec": "1h",
        "OOMPolicy": "stop",
        "OnFailure": "brokkr-systemd-failure@%n.service",
        "WatchdogSec": "30s"
      },
      "heartbeat": { "app_heartbeat": "present", "live_lock_fixture": "passed" },
      "readiness": "present"
    },
    {
      "target_node_id": "node-core",
      "scope": "system",
      "name": "grimnir-worker.service",
      "failure_handler_role": "none",
      "directives": {
        "Type": "oneshot",
        "Restart": "no",
        "StartLimitIntervalSec": "60s",
        "StartLimitBurst": "3",
        "TimeoutStartSec": "120s",
        "TimeoutStopSec": "30s",
        "RuntimeMaxSec": "10m",
        "OOMPolicy": "stop",
        "OnFailure": "brokkr-systemd-failure@%n.service"
      },
      "heartbeat": { "app_heartbeat": "not-applicable", "live_lock_fixture": "not-applicable" },
      "readiness": "not-applicable"
    },
    {
      "target_node_id": "node-core",
      "scope": "system",
      "name": "grimnir-worker.timer",
      "failure_handler_role": "none",
      "directives": {
        "Unit": "grimnir-worker.service",
        "StartLimitIntervalSec": "60s",
        "StartLimitBurst": "3",
        "OnFailure": "brokkr-systemd-failure@%n.service",
        "OnCalendar": "*:0/5",
        "Persistent": true,
        "AccuracySec": "30s"
      },
      "heartbeat": { "app_heartbeat": "not-applicable", "live_lock_fixture": "not-applicable" },
      "readiness": "not-applicable"
    },
    {
      "target_node_id": "node-workshop",
      "scope": "user",
      "name": "workshop.service",
      "failure_handler_role": "none",
      "directives": {
        "Type": "simple",
        "Restart": "on-failure",
        "RestartSec": "10s",
        "StartLimitIntervalSec": "120s",
        "StartLimitBurst": "4",
        "TimeoutStartSec": "60s",
        "TimeoutStopSec": "60s",
        "RuntimeMaxSec": "infinity",
        "OOMPolicy": "kill",
        "OnFailure": "workshop-failure.service"
      },
      "heartbeat": { "app_heartbeat": "present", "live_lock_fixture": "passed" },
      "readiness": "present"
    },
    {
      "target_node_id": "node-workshop",
      "scope": "user",
      "name": "workshop.timer",
      "failure_handler_role": "none",
      "directives": {
        "StartLimitIntervalSec": "60s",
        "StartLimitBurst": "3",
        "OnFailure": "workshop-failure.service",
        "OnUnitActiveSec": "10m",
        "AccuracySec": "30s"
      },
      "heartbeat": { "app_heartbeat": "not-applicable", "live_lock_fixture": "not-applicable" },
      "readiness": "not-applicable"
    },
    {
      "target_node_id": "node-workshop",
      "scope": "user",
      "name": "workshop-failure.service",
      "failure_handler_role": "terminal",
      "directives": {
        "Type": "oneshot",
        "Restart": "no",
        "StartLimitIntervalSec": "60s",
        "StartLimitBurst": "3",
        "TimeoutStartSec": "120s",
        "TimeoutStopSec": "30s",
        "RuntimeMaxSec": "10m",
        "OOMPolicy": "stop"
      },
      "heartbeat": { "app_heartbeat": "not-applicable", "live_lock_fixture": "not-applicable" },
      "readiness": "not-applicable"
    }
  ]
}
