{
  "kind": "systemd-unit-declarations",
  "schema_version": "v1",
  "topology_authority": "grimnir-service-registry",
  "units": [
    {
      "name": "grimnir-api.service",
      "directives": {
        "Type": "notify",
        "Restart": "on-failure",
        "RestartSec": "5s",
        "StartLimitIntervalSec": "60s",
        "StartLimitBurst": "5",
        "TimeoutStartSec": "30s",
        "TimeoutStopSec": "30s",
        "RuntimeMaxSec": "1h",
        "OOMPolicy": "stop",
        "OnFailure": "brokkr-systemd-failure@%n.service",
        "WatchdogSec": "30s"
      },
      "heartbeat": {
        "app_heartbeat": "present",
        "live_lock_fixture": "passed"
      },
      "readiness": "present",
      "failure_delivery": "brokkr-systemd-failure"
    },
    {
      "name": "grimnir-worker.service",
      "directives": {
        "Type": "oneshot",
        "Restart": "no",
        "StartLimitIntervalSec": "60s",
        "StartLimitBurst": "3",
        "TimeoutStartSec": "120s",
        "TimeoutStopSec": "30s",
        "RuntimeMaxSec": "10m",
        "OOMPolicy": "stop",
        "OnFailure": "brokkr-systemd-failure@%n.service"
      },
      "heartbeat": {
        "app_heartbeat": "not-applicable",
        "live_lock_fixture": "not-applicable"
      },
      "readiness": "not-applicable",
      "failure_delivery": "brokkr-systemd-failure"
    },
    {
      "name": "grimnir-worker.timer",
      "directives": {
        "Unit": "grimnir-worker.service",
        "OnCalendar": "*:0/5",
        "Persistent": true,
        "AccuracySec": "30s"
      },
      "heartbeat": {
        "app_heartbeat": "not-applicable",
        "live_lock_fixture": "not-applicable"
      },
      "readiness": "not-applicable",
      "failure_delivery": "not-declared"
    },
    {
      "name": "workshop.service",
      "directives": {
        "Type": "simple",
        "Restart": "on-failure",
        "RestartSec": "10s",
        "StartLimitIntervalSec": "120s",
        "StartLimitBurst": "4",
        "TimeoutStartSec": "60s",
        "TimeoutStopSec": "60s",
        "RuntimeMaxSec": "infinity",
        "OOMPolicy": "kill",
        "OnFailure": "workshop-failure@%n.service"
      },
      "heartbeat": {
        "app_heartbeat": "present",
        "live_lock_fixture": "passed"
      },
      "readiness": "present",
      "failure_delivery": "component-owner"
    }
  ]
}
