{
  "kind": "systemd-unit-declarations",
  "schema_version": "v1",
  "topology_authority": "grimnir-service-registry",
  "units": [
    {
      "target_node_id": "node-alpha", "scope": "system", "name": "shared.service", "failure_handler_role": "none",
      "directives": { "Type": "simple", "Restart": "on-failure", "RestartSec": "5s", "StartLimitIntervalSec": "60s", "StartLimitBurst": "5", "TimeoutStartSec": "30s", "TimeoutStopSec": "30s", "RuntimeMaxSec": "1h", "OOMPolicy": "stop", "OnFailure": "brokkr-systemd-failure@%n.service" },
      "heartbeat": { "app_heartbeat": "present", "live_lock_fixture": "passed" }, "readiness": "present"
    },
    {
      "target_node_id": "node-beta", "scope": "system", "name": "shared.service", "failure_handler_role": "none",
      "directives": { "Type": "simple", "Restart": "on-failure", "RestartSec": "5s", "StartLimitIntervalSec": "60s", "StartLimitBurst": "5", "TimeoutStartSec": "30s", "TimeoutStopSec": "30s", "RuntimeMaxSec": "1h", "OOMPolicy": "stop", "OnFailure": "brokkr-systemd-failure@%n.service" },
      "heartbeat": { "app_heartbeat": "present", "live_lock_fixture": "passed" }, "readiness": "present"
    },
    {
      "target_node_id": "node-alpha", "scope": "user", "name": "shared.service", "failure_handler_role": "none",
      "directives": { "Type": "simple", "Restart": "on-failure", "RestartSec": "5s", "StartLimitIntervalSec": "60s", "StartLimitBurst": "5", "TimeoutStartSec": "30s", "TimeoutStopSec": "30s", "RuntimeMaxSec": "1h", "OOMPolicy": "stop", "OnFailure": "gamma-failure.service" },
      "heartbeat": { "app_heartbeat": "present", "live_lock_fixture": "passed" }, "readiness": "present"
    },
    {
      "target_node_id": "node-alpha", "scope": "user", "name": "gamma-failure.service", "failure_handler_role": "terminal",
      "directives": { "Type": "oneshot", "Restart": "no", "StartLimitIntervalSec": "60s", "StartLimitBurst": "3", "TimeoutStartSec": "120s", "TimeoutStopSec": "30s", "RuntimeMaxSec": "10m", "OOMPolicy": "stop" },
      "heartbeat": { "app_heartbeat": "not-applicable", "live_lock_fixture": "not-applicable" }, "readiness": "not-applicable"
    }
  ]
}
