// Grimnir-managed unattended-upgrades baseline — installed by
// scripts/setup-host-patching.sh onto Debian / Raspberry Pi OS hosts.
//
// This file is the SECURITY BASELINE, not the whole policy (Grimnir ADR-009):
//   * Security: only the Debian-Security archive is listed here.
//   * Regular updates (Debian stable and stable-updates, the Raspberry Pi
//     archive with kernel / firmware / rpi-eeprom, gh) come from the
//     52brokkr-debian-updates drop-in, and Claude Code from 51brokkr-claude-code;
//     apt appends their Origins-Pattern entries to the list below.
//   * NO automatic reboot, ever, from unattended-upgrades. Automatic-Reboot
//     stays "false" because reboots are done by Brokkr's guarded-reboot job
//     (workload, load and session guards, post-boot check, audit trail), never
//     by unattended-upgrades. A pending reboot is also surfaced by the daily
//     brokkr-maintenance-os report (Munin + Telegram).

Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};

// No packages held back.
Unattended-Upgrade::Package-Blacklist {
};

// Repair a dpkg state interrupted by a crash/power loss on the next run.
Unattended-Upgrade::AutoFixInterruptedDpkg "true";

// Upgrade in minimal increments so a power loss leaves a consistent system.
Unattended-Upgrade::MinimalSteps "true";

// Keep the boot partition tidy — superseded kernels are auto-removed.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Dependencies "false";

// Never reboot from unattended-upgrades — Brokkr's guarded-reboot job does it
// (ADR-009); the reboot-required flag is still surfaced by the OS report.
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Automatic-Reboot-WithUsers "false";

// No MTA on these hosts; rely on Grimnir's Munin/Telegram reporting instead.
Unattended-Upgrade::Mail "";

// Log to syslog so journalctl / the maintenance report can read outcomes.
Unattended-Upgrade::SyslogEnable "true";
