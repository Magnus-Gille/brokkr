# Brokkr · wired-link health snapshot (oneshot, driven by brokkr-link-health.timer).
# For fleet nodes outside the NAS platform report. Install manually through the
# host's approved deployment path; see docs/link-health.md.
[Unit]
Description=Brokkr wired-link health snapshot
Documentation=https://github.com/Magnus-Gille/brokkr/blob/main/docs/link-health.md
After=network-online.target
Wants=network-online.target
OnFailure=brokkr-systemd-failure@%n.service

[Service]
Type=oneshot
User=brokkr
# Reading kernel records with journalctl -k needs journal group membership;
# the ethtool get/statistics queries need no extra privilege.
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/brokkr
# Provides HEIMDALL_HUB_URL + HEIMDALL_FLEET_TOKEN; required (delivery is the point).
EnvironmentFile=/home/brokkr/.config/brokkr/env
Environment=BROKKR_LINK_HEALTH_CONFIG=/home/brokkr/.config/brokkr/link-health.conf
ExecStart=/opt/brokkr/scripts/link-health-snapshot.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
TimeoutStartSec=90
