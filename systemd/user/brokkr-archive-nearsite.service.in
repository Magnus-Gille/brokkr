# Brokkr · monthly self-check of the near-site archive copy (oneshot, driven by
# brokkr-archive-nearsite.timer). User unit for the host that holds the near-site copy.
# Rendered and installed by scripts/deploy-archive-nearsite.sh; do not copy this
# template by hand.
[Unit]
Description=Brokkr archive near-site self-check
Documentation=https://github.com/Magnus-Gille/brokkr/blob/main/docs/archive-nearsite.md
# No OnFailure=: brokkr-systemd-failure@.service is a system unit and does not
# exist in user scope. A failed run stays visible in the service state and as a
# failing or stale Heimdall archive-nearsite panel.

[Service]
Type=oneshot
# Rendered by deploy-archive-nearsite.sh with an exact full revision and the
# operator's protected-file paths.
WorkingDirectory=%h/.local/lib/brokkr/archive-nearsite/releases/@REVISION@
# No EnvironmentFile=: the delivery env file is shared with other units, and a blacklist of
# variables to strip from it can never be complete (loader hooks such as LD_AUDIT, the
# interpreters' startup and user-site hooks, exported shell functions, tracing options).
# Instead the script starts under `env -i` with an explicit allowlist (HOME, PATH, LANG)
# and reads the file itself, taking only the two Heimdall values it needs, in-process and
# never on a command line. The command line carries file paths only, no secret.
# The config is parsed (never sourced) by the script and is the only source of the
# directory, manifest and pin.
ExecStart=/usr/bin/env -i HOME=%h PATH=@UNIT_PATH@ LANG=@UNIT_LANG@ %h/.local/lib/brokkr/archive-nearsite/releases/@REVISION@/scripts/archive-nearsite.sh --config @ARCHIVE_CONFIG@ --delivery-env @DELIVERY_ENV@ --verify
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
# strict makes the whole filesystem read-only (ReadWritePaths is only an exception list:
# with full, /srv, /mnt and /var would stay writable, and the near-site copy lives there).
ProtectSystem=strict
ProtectHome=read-only
# Everything written (snapshot, stamps, lock, work directory) is under the state dir, or
# in the private /tmp. The deploy creates the state dir; if it is missing the unit fails
# to start rather than running with a writable filesystem.
ReadWritePaths=%h/.local/state/brokkr
# The check re-hashes the whole near-site copy.
TimeoutStartSec=12h
